{% extends "layouts/frame.njk" %}
{% from "layouts/_app-chrome.njk" import appChrome %}
{% from "components/layout/page-header/page-header.njk" import pageHeader %}
{% from "components/common/card/card.njk" import card %}
{% from "components/common/stat-block/stat-block.njk" import statBlock %}
{% from "components/common/area-chart/area-chart.njk" import areaChart %}
{% from "components/common/gauge-chart/gauge-chart.njk" import gaugeChart %}
{% from "components/common/chart-legend/chart-legend.njk" import chartLegend %}
{% from "components/common/meter-bar/meter-bar.njk" import meterBar %}
{% from "components/common/project-item/project-item.njk" import projectItem %}
{% from "components/common/countdown-timer/countdown-timer.njk" import countdownTimer %}
{% from "components/common/pinned-project/pinned-project.njk" import pinnedProject %}
{% from "components/common/inbox-card/inbox-card.njk" import inboxCard %}
{% from "components/common/empty-state/empty-state.njk" import emptyState %}
{% from "components/common/error-state/error-state.njk" import errorState %}
{% from "components/ui/legend-toggle/legend-toggle.njk" import legendToggle %}
{% from "components/ui/avatar-stack/avatar-stack.njk" import avatarStack %}
{% from "components/ui/button/button.njk" import button %}
{% from "components/ui/skeleton/skeleton.njk" import skeleton %}
{% set bodyClass = "antialiased" %}
{% block body %}
{#- Data -#}
{% set today = project.referenceDate.slice(0, 10) %}
{% set months = data.fixtures.revenueMonth.scenarios[scenario].slice(-6) %}
{% set projects = data.fixtures.project.scenarios[scenario] %}
{% set tasks = data.fixtures.task.scenarios[scenario] %}
{% set proposals = [] %}{% for q in data.fixtures.proposal.scenarios[scenario] %}{% if q.status == "pending" %}{% set _ = proposals.push(q) %}{% endif %}{% endfor %}
{% set team = data.fixtures.teamMember.scenarios[scenario].slice(0, 4) %}
{% set clients = data.fixtures.client.scenarios[scenario].slice(0, 5) %}
{% set meeting = data.fixtures.meeting.scenarios[scenario] | first %}
{% set monthNames = data.glossary.monthsShort | label %}
{% set stageCodes = ["discovery", "design", "development", "review", "launch"] %}
{% set labels = [] %}{% set revenue = [] %}{% set expense = [] %}
{% for m in months %}{% set _ = labels.push(monthNames[(m.month.slice(5, 7) | int) - 1]) %}{% set _ = revenue.push(m.revenueMinor) %}{% set _ = expense.push(m.expenseMinor) %}{% endfor %}
{% set byStatus = projects | groupby("status") %}
{% set statusTone = { in_progress: "accent-strong", completed: "accent", in_review: "accent-subtle", on_hold: "neutral" } %}
{% set segments = [] %}
{% for code in ["in_progress", "completed", "in_review", "on_hold"] %}{% set _ = segments.push({ label: data.statuses.projectStatus[code].label | label, count: (byStatus[code] or []) | length, tone: statusTone[code] }) %}{% endfor %}
{% set healthTone = { normal: "accent", on_track: "success", at_risk: "danger" } %}
{% set kindIcon = { website: "globe", app: "code", marketing: "megaphone", landing: "layout-template" } %}
{% set taskTone = { todo: "neutral", in_progress: "accent", in_review: "warning", done: "success" } %}
{% set proposalIcon = { invoice: "file-text", payment: "wallet", project: "folder", client: "user-plus", task: "square-check" } %}
{% set topMember = team | sort(true, false, "workloadPercent") | first %}
{% set topClient = clients | sort(true, false, "revenueMinor") | first %}
{% set pinned = (projects | selectattr("pinned") | first) %}
{% set messages = { loading: "Loading…", emptyTitle: "No data for this period", emptyText: "The chart fills in as soon as the first payments arrive.", errorTitle: "The chart didn't load", errorText: "Something went wrong on our side. Try again in a minute.", retry: "Try again" } %}


{#- Pinned project: its stage, open tasks and the next three by due date -#}
{% if pinned %}
  {% set stages = [] %}{% for code in stageCodes %}{% set _ = stages.push({ name: data.statuses.projectStage[code].label | label }) %}{% endfor %}
  {% set open = [] %}{% for t in tasks %}{% if t.projectId == pinned.id and t.status != "done" %}{% set _ = open.push(t) %}{% endif %}{% endfor %}
  {% set next = [] %}
  {% for t in (open | sort(false, false, "dueDate")).slice(0, 3) %}
    {% set _ = next.push({ title: t.title, href: "#board", due: (monthNames[(t.dueDate.slice(5, 7) | int) - 1] ~ " " ~ (t.dueDate.slice(8, 10) | int)) if t.dueDate else "not set", overdue: t.dueDate and t.dueDate < today, status: data.statuses.taskStatus[t.status].label | label, tone: taskTone[t.status], assignee: t.assigneeName }) %}
  {% endfor %}
  {% set words = pinned.title.split(" ") %}
  {% set pinnedCard = { title: pinned.title, href: "#project", client: pinned.clientName or "Internal project", due: (monthNames[(pinned.dueDate.slice(5, 7) | int) - 1] ~ " " ~ (pinned.dueDate.slice(8, 10) | int)) if pinned.dueDate else null, monogram: ((words[0] | first) ~ ((words[1] or "") | first)) | upper, cover: pinned.cover, boardHref: "#board" } %}
{% endif %}
{% set recent = [] %}
{% for p in (projects | selectattr("openedAt") | sort(true, false, "openedAt")).slice(0, 3) %}{% set _ = recent.push({ title: p.title, href: "#project", meta: (p.clientName or "Internal project") ~ " · " ~ (data.statuses.projectStage[p.stage].label | label) }) %}{% endfor %}

{#- Inbox: newest three proposals -#}
{% set inboxItems = [] %}
{% for q in (proposals | sort(true, false, "createdAt")).slice(0, 3) %}
  {% set checkLabel = (q.fieldsToCheck | plural({ one: "# field to check", other: "# fields to check" })) if q.check == "to_check" and q.fieldsToCheck else (data.statuses.proposalCheck[q.check].label | label) %}
  {% set _ = inboxItems.push({ title: q.title, href: "proposal-create.html", meta: (data.statuses.proposalSource[q.source].label | label) ~ " · " ~ q.authorName ~ " · " ~ (q.createdAt | relative), icon: proposalIcon[q.kind] or "inbox", action: data.statuses.proposalAction[q.action].label | label, check: checkLabel, checkTone: data.statuses.proposalCheck[q.check].tone }) %}
{% endfor %}

{% call appChrome("dashboard", scenario=scenario, capture=frame.capture or {}) %}
  {% call pageHeader("Dashboard overview", "Here's what's happening with your business today") %}
    {{ button("Create invoice", variant="secondary", iconLeading="file-text", href="#new-invoice") }}
    {{ button("Add client", variant="secondary", iconLeading="user-plus", href="#new-client") }}
    {{ button("New project", iconLeading="plus", href="#new-project") }}
  {% endcall %}

  {% if state == "error" %}
  <div class="rounded-lg bg-surface p-6">{{ errorState("The dashboard didn't load", "Something went wrong on our side. Your data is safe — try again in a minute.", "Try again") }}</div>
  {% else %}
  {#- 4 : 3 : 3 : 3 columns from the design: the pinned project column is wider than the three data columns. -#}
  <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-[minmax(0,4fr)_repeat(3,minmax(0,3fr))]"{% if state == "loading" %} aria-busy="true"{% endif %}>
    {% if state == "loading" %}<p class="sr-only">Loading…</p>{% endif %}

    <div class="grid xl:row-span-2">
      {% if state == "loading" %}
        {% call card("pinned-loading") %}<div class="flex flex-col gap-4">{{ skeleton("line", layout="w-32") }}{{ skeleton("title", layout="w-3/4") }}{{ skeleton("block", layout="w-full") }}{{ skeleton("line", layout="w-full") }}{% for i in range(3) %}{{ skeleton("line", layout="w-full") }}{% endfor %}</div>{% endcall %}
      {% elif pinned %}
        {{ pinnedProject("pinned", project=pinnedCard, stages=stages, current=stageCodes.indexOf(pinned.stage), percent=pinned.progressPercent, tasks=next, openCount=open | length) }}
      {% else %}
        {{ pinnedProject("pinned", recent=recent, allHref="#projects") }}
      {% endif %}
    </div>

    {% call card("revenue", title="Revenue overview", actionHref="#finance", actionLabel="Open finance", layout="xl:col-span-2") %}
      <div class="flex flex-col gap-6 xl:flex-row">
        <div class="flex shrink-0 flex-col justify-between gap-6 pt-4">
          {% if state == "loading" %}
            <div class="flex flex-col gap-2">{{ skeleton("line", layout="w-32") }}{{ skeleton("figure", layout="w-40") }}{{ skeleton("line", layout="w-16") }}</div>
          {% elif months | length %}
            {% set last = months | last %}{% set prev = months[months.length - 2] if months.length > 1 else null %}
            {% if prev and prev.revenueMinor > 0 %}
              {% set change = (last.revenueMinor - prev.revenueMinor) / prev.revenueMinor %}
              {{ statBlock("This month earning", last.revenueMinor | money(last.currency), delta=(change | abs) | percent(1), trend="up" if change >= 0 else "down", trendLabel=("Up" if change >= 0 else "Down") ~ " from last month") }}
            {% else %}
              {{ statBlock("This month earning", last.revenueMinor | money(last.currency)) }}
            {% endif %}
          {% endif %}
          {{ legendToggle([{ id: "revenue", label: "Revenue", state: "on" }, { id: "expense", label: "Expense", state: "on" }], "Chart series") }}
        </div>
        <div class="flex min-w-0 flex-1 items-end">
          <div class="w-full">{{ areaChart(labels, revenue, "Revenue and expense by month", seriesLabel="Revenue", area=expense, areaLabel="Expense", highlight=(months | length) - 1 if months | length else null, tagLabel=((months | last).revenueMinor | money((months | last).currency)) if months | length else null, currency=(months | first).currency if months | length else null, messages=messages, state=state) }}</div>
        </div>
      </div>
    {% endcall %}

    {% call card("status", title="Project status", actionHref="#projects", actionLabel="Open projects") %}
      <div class="flex flex-col gap-5 pt-2">
        {{ gaugeChart(segments, "Projects by status", caption="Projects", messages=messages, state=state) }}
        {% if state == "default" and projects | length %}{{ chartLegend(segments) }}{% endif %}
      </div>
    {% endcall %}

    {% call card("team", title="Team workload", actionHref="#team", actionLabel="Open team") %}
      {% if state == "loading" %}
        <div class="flex flex-col gap-4">{% for i in range(4) %}<div class="flex flex-col gap-2">{{ skeleton("line", layout="w-24") }}{{ skeleton("title", layout="w-full") }}</div>{% endfor %}</div>
      {% elif team | length %}
        <ul class="flex flex-col gap-4">
          {% for m in team %}<li>{{ meterBar("team-" ~ m.id, m.name, [m.workloadPercent or 0, 100] | sort | first, highlight=(m.id == topMember.id), valueLabel=(null if m.workloadPercent is not none else "No hours set")) }}</li>{% endfor %}
        </ul>
      {% else %}
        {{ emptyState("No team members yet", "Invite your team to see how much of each person's month is booked.", iconName="users") }}
      {% endif %}
    {% endcall %}

    {% call card("active", title="Active projects", actionHref="#projects", actionLabel="Open all projects") %}
      {% if state == "loading" %}
        <div class="flex flex-col gap-4">{% for i in range(4) %}<div class="flex items-center gap-3">{{ skeleton("tile") }}<div class="flex flex-1 flex-col gap-2">{{ skeleton("line", layout="w-3/4") }}{{ skeleton("line", layout="w-1/2") }}</div></div>{% endfor %}</div>
      {% elif (byStatus.in_progress or []) | length %}
        <ul class="flex flex-col gap-4">
          {% for p in (byStatus.in_progress).slice(0, 4) %}<li>{{ projectItem(p.title, ("Client: " ~ p.clientName) if p.clientName else "Internal project", kindIcon[p.kind], p.progressPercent, tone=healthTone[p.health], statusLabel=(null if p.health == "normal" else (data.statuses.projectHealth[p.health].label | label))) }}</li>{% endfor %}
        </ul>
      {% else %}
        {% call emptyState("No active projects", "Projects you start appear here with their progress.", iconName="folder") %}{{ button("New project", size="sm", iconLeading="plus", href="#new-project") }}{% endcall %}
      {% endif %}
    {% endcall %}

    <div class="flex min-w-0 flex-col gap-3">
      {% call card("meeting", title="Next meeting in", actionHref="#calendar", actionLabel="Open calendar") %}
        {% if state == "loading" %}{{ skeleton("block", layout="w-full") }}
        {% elif meeting %}<div class="flex flex-col gap-2">{{ countdownTimer(meeting.startsInSeconds, "Time until " ~ (meeting.title or "the next meeting")) }}<p class="text-sm text-fg-secondary">{{ meeting.title or "Meeting" }} · {{ meeting.startsAt | time }}</p></div>
        {% else %}{{ emptyState("No meetings scheduled", "Your next meeting shows up here.", iconName="calendar") }}{% endif %}
      {% endcall %}
      {% call card("clients", title="Top clients", actionHref="#clients", actionLabel="Open clients", layout="flex-1") %}
        {% if state == "loading" %}<div class="flex gap-2 pt-14">{% for i in range(5) %}{{ skeleton("circle") }}{% endfor %}</div>
        {% elif clients | length %}{{ avatarStack(clients, "Top clients by revenue", highlight=clients.indexOf(topClient), tag=topClient.revenueMinor | money(topClient.currency)) }}
        {% else %}{{ emptyState("No clients yet", "Clients appear here once they're billed.", iconName="user-plus") }}{% endif %}
      {% endcall %}
    </div>

    <div class="grid md:col-span-2 xl:col-span-4">
      {% if state == "loading" %}
        {% call card("inbox-loading") %}<div class="flex flex-col gap-4">{{ skeleton("title", layout="w-1/3") }}<div class="grid gap-3 lg:grid-cols-3">{% for i in range(3) %}{{ skeleton("block", layout="w-full") }}{% endfor %}</div></div>{% endcall %}
      {% else %}
        {{ inboxCard("inbox", proposals | length, inboxItems, "inbox.html") }}
      {% endif %}
    </div>
  </div>
  {% endif %}
{% endcall %}
{% endblock %}
