{#- PasswordRules. What a new password needs, each rule ticked when met; linked to the password field with aria-describedby. Props: id, rules [{ text, met }]. The state is also read out ("done" / "not yet"), never color alone. -#}
{% macro passwordRules(id, rules) %}
{%- set v = variants.passwordRules -%}
<ul id="{{ id }}" data-component="PasswordRules" aria-live="polite" class="{{ v.base }}">{% for r in rules %}<li class="{{ v.slots.rule }} {{ v.variants.state.met if r.met else v.variants.state.unmet }}">{{ icon("circle-check" if r.met else "circle", v.slots.icon) }}<span>{{ r.text }}</span><span class="sr-only">{{ ", done" if r.met else ", not yet" }}</span></li>{% endfor %}</ul>
{%- endmacro %}
