{% extends "layouts/matrix.njk" %}
{% from "layouts/_matrix-macros.njk" import section, cell %}
{% from "components/form/password-rules/password-rules.njk" import passwordRules %}
{% set description = "What a new password needs, each rule ticked when met." %}
{% block matrix %}

{% call section("progress") %}
  {% call cell("empty") %}<div class="w-72">{{ passwordRules("m-pr-1", [{ text: "At least 10 characters", met: false }, { text: "A number", met: false }, { text: "Not the same as your email", met: false }]) }}</div>{% endcall %}
  {% call cell("partly met") %}<div class="w-72">{{ passwordRules("m-pr-2", [{ text: "At least 10 characters", met: true }, { text: "A number", met: false }, { text: "Not the same as your email", met: true }]) }}</div>{% endcall %}
  {% call cell("all met") %}<div class="w-72">{{ passwordRules("m-pr-3", [{ text: "At least 10 characters", met: true }, { text: "A number", met: true }, { text: "Not the same as your email", met: true }]) }}</div>{% endcall %}
{% endcall %}
{% endblock %}
