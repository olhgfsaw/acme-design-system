{% extends "layouts/matrix.njk" %}
{% from "layouts/_matrix-macros.njk" import section, cell %}
{% from "components/common/countdown-timer/countdown-timer.njk" import countdownTimer %}
{% set description = "A single live figure, alone under a card title." %}
{% block matrix %}

{% call section("value") %}
  {% call cell("typical") %}{{ countdownTimer(sample.countdownSeconds, sample.countdownLabel) }}{% endcall %}
  {% call cell("under a minute") %}{{ countdownTimer(42, sample.countdownLabel) }}{% endcall %}
{% endcall %}
{% endblock %}
