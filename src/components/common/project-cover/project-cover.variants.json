    "stripes": {
      "mono": "bg-surface px-2",
      "line": "stroke-info-border"
    },
    "plain": {
      "mono": "",
      "line": ""
    }
  },
  "slots": {
    "svg": "absolute inset-0 size-full",
    "mono": "relative inline-flex rounded-xs text-3xl/10 font-semibold tracking-tight",
    "monoTile": "relative text-sm font-semibold",
    "foreign": "flex size-full items-end px-4 pb-3"
  },
  "defaultVariants": {
    "pattern": "plain",
