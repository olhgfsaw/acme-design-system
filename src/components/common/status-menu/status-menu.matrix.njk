{% extends "layouts/matrix.njk" %}
{% from "layouts/_matrix-macros.njk" import section, cell %}
{% from "components/common/status-menu/status-menu.njk" import statusMenu %}
{% set description = "A status badge that opens the list of statuses." %}
{% block matrix %}

{% set opts = [{ code: "draft", label: "Draft", tone: "neutral", hint: "Not sent yet" }, { code: "sent", label: "Sent", tone: "info", hint: "Waiting for payment" }, { code: "paid", label: "Paid", tone: "success", hint: "Paid in full" }, { code: "overdue", label: "Overdue", tone: "danger", hint: "Set automatically after the due date", disabled: true }] %}
{% call section("state") %}
  {% call cell("closed") %}{{ statusMenu("m-sm-1", "INV-2026-048", "sent", opts) }}{% endcall %}
  {% call cell("open") %}<div class="flex h-96 w-72 flex-col">{{ statusMenu("m-sm-2", "INV-2026-048", "sent", opts, open=true, footer={ label: "Open invoice", hint: "Record a part payment, send a reminder", href: "#" }) }}</div>{% endcall %}
{% endcall %}
{% endblock %}
