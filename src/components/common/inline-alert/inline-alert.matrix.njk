{% extends "layouts/matrix.njk" %}
{% from "layouts/_matrix-macros.njk" import section, cell %}
{% from "components/common/inline-alert/inline-alert.njk" import inlineAlert %}
{% set description = "A message at the section it concerns." %}
{% block matrix %}

{% call section("tone") %}
  {% for t in ["info", "success", "warning", "danger"] %}{% call cell(t) %}<div class="w-96">{{ inlineAlert("This project changed after the proposal was made", "Olivia Foster moved the due date to Nov 27 today at 10:12 AM.", tone=t) }}</div>{% endcall %}{% endfor %}
{% endcall %}
{% endblock %}
