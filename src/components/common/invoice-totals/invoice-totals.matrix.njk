{% set description = "Subtotal, tax and the total of an invoice." %}
{% block matrix %}

{% call section("totals") %}
  {% call cell("with tax") %}<div class="w-80">{{ invoiceTotals("USD", [{ label: "Subtotal", amountMinor: 900000 }, { label: "Tax 0%", amountMinor: 0 }], 900000) }}</div>{% endcall %}
{% endcall %}
{% endblock %}
