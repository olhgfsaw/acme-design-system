{#- PageHeader. Props: title (names the place), description (one friendly sentence), level (1 on a screen), crumbs (Breadcrumbs items above the title), avatar (a name: large avatar before the title), badge ({ label, tone } next to the title), kicker (badges above the title: [{ label, tone }]), cover ({ id, monogram, pattern }: a project cover tile), lead (rendered markup in the avatar place, e.g. a CoverPicker), titleAside (rendered markup after the title instead of the badge, e.g. a StatusMenu). Default slot = the page's buttons: secondaries first, the one primary last. -#}
{% from "components/common/breadcrumbs/breadcrumbs.njk" import breadcrumbs %}
{% from "components/ui/avatar/avatar.njk" import avatar as _avatar %}
{% from "components/ui/badge/badge.njk" import badge as _badge %}
{% from "components/common/project-cover/project-cover.njk" import projectCover as _cover %}
{% macro pageHeader(title, description=null, level=1, crumbs=null, avatar=null, badge=null, kicker=null, cover=null, lead=null, titleAside=null, avatarSize=null) %}
{%- set v = variants.pageHeader -%}
<div data-component="PageHeader" class="{{ v.base }}">
  <div class="{{ v.slots.lead }}">
    {%- if crumbs %}{{ breadcrumbs(crumbs) }}{% endif %}
    <div class="{{ v.slots.identity }}">{% if lead %}{{ lead | safe }}{% elif cover %}{{ _cover(cover.id, cover.monogram, pattern=cover.pattern, size="header") }}{% elif avatar %}{{ _avatar(avatar, size=(avatarSize or "lg"), decorative=true) }}{% endif %}<div class="{{ v.slots.text }}">{% if kicker %}<div class="{{ v.slots.kicker }}">{% for k in kicker %}{{ _badge(k.label, tone=k.tone or "neutral", dot=false) }}{% endfor %}</div>{% endif %}<div class="{{ v.slots.titleRow }}"><h{{ level }} class="{{ v.slots.title }}">{{ title }}</h{{ level }}>{% if titleAside %}{{ titleAside | safe }}{% elif badge %}{{ _badge(badge.label, tone=badge.tone) }}{% endif %}</div>{% if description %}<p class="{{ v.slots.description }}">{{ description }}</p>{% endif %}</div></div>
  </div>
  {%- if caller %}<div data-slot="actions" class="{{ v.slots.actions }}">{{ caller() }}</div>{% endif %}
</div>
{%- endmacro %}
