{#- NavRail. Props: items [{ id, label, icon, href, count }] (label = accessible name and must include the count: "Inbox, 7 to review"), label (nav name), activeId, footer (items pinned to the bottom: log out). Icons only, eight sections or fewer; the current one is filled with primary. Wraps into rows on phones. -#}
{% macro navRail(items, label, activeId=null, footer=[]) %}
{%- set v = variants.navRail -%}
<nav data-component="NavRail" aria-label="{{ label }}" class="{{ v.base }}">
  <ul class="{{ v.slots.list }}">
    {%- for it in items %}
    <li><a href="{{ it.href }}" aria-label="{{ it.label }}"{% if it.id == activeId %} aria-current="page"{% endif %} class="{{ v.slots.item }}">{{ icon(it.icon, "size-5") }}{% if it.count %}<span class="{{ v.slots.count }}" aria-hidden="true">{{ it.count }}</span>{% endif %}</a></li>
    {%- endfor %}
  </ul>
  {%- if footer | length %}
  <ul class="{{ v.slots.footer }}">
    {%- for it in footer %}
    <li><a href="{{ it.href }}" aria-label="{{ it.label }}" class="{{ v.slots.item }}">{{ icon(it.icon, "size-5") }}</a></li>
    {%- endfor %}
  </ul>
  {%- endif %}
</nav>
{%- endmacro %}
