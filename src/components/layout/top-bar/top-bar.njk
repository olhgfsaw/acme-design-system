{#- TopBar. Props: brand (product name, links home), searchPlaceholder, searchLabel (accessible name of the search), homeHref, searchId, context (a chip after the brand naming the space: "My space"). Default slot = actions: icon buttons, then the account avatar. Search drops to its own row on phones. -#}
{% from "components/ui/input/input.njk" import input %}
{% macro topBar(brand, searchPlaceholder, searchLabel, homeHref="#", searchId="global-search", context=null) %}
{%- set v = variants.topBar -%}
<header data-component="TopBar" class="{{ v.base }}">
  {% if context %}<div class="{{ v.slots.home }}"><a href="{{ homeHref }}" class="{{ v.slots.brand }}">{{ brand }}</a><span class="{{ v.slots.context }}">{{ context }}</span></div>{% else %}<a href="{{ homeHref }}" class="{{ v.slots.brand }}">{{ brand }}</a>{% endif %}
  <div role="search" class="{{ v.slots.search }}">{{ input(searchId, type="search", placeholder=searchPlaceholder, label=searchLabel, variant="search", size="lg", iconLeading="search") }}</div>
  {%- if caller %}<div data-slot="actions" class="{{ v.slots.actions }}">{{ caller() }}</div>{% endif %}
</header>
{%- endmacro %}
