{% extends "layouts/matrix.njk" %}
{% from "layouts/_matrix-macros.njk" import section, cell %}
{% from "components/ui/legend-toggle/legend-toggle.njk" import legendToggle %}
{% set description = "Series switches. data-state on / off as in Reka ToggleGroup; aria-pressed for assistive tech." %}
{% block matrix %}

{% for direction in ["column", "row"] %}
  {% call section(direction) %}
    {% call cell("first on, second off") %}{{ legendToggle(sample.series, sample.seriesLabel, direction=direction) }}{% endcall %}
  {% endcall %}
{% endfor %}
{% endblock %}
