{% extends "layouts/matrix.njk" %}
{% from "layouts/_matrix-macros.njk" import section, cell %}
{% from "components/ui/code-tag/code-tag.njk" import codeTag %}
{% set description = "A short technical value shown as code: an API scope, a key name, a file pattern." %}
{% block matrix %}

{% call section("values") %}
  {% call cell("short") %}{{ codeTag("calendar.events") }}{% endcall %}
  {% call cell("long") %}<div class="w-48">{{ codeTag("calendar.calendarlist.readonly") }}</div>{% endcall %}
{% endcall %}
{% endblock %}
