{#- BaseSwitch. Props: id, label, description, checked, disabled. An on / off setting that applies at once. Reka Switch: role="switch", data-state on the track and the thumb. -#}
{% macro switch(id, label, description=null, checked=false, disabled=false) %}
{%- set v = variants.switch -%}
{%- set st = "checked" if checked else "unchecked" -%}
<div data-component="BaseSwitch" class="{{ v.base }}">
  <span class="{{ v.slots.text }}"><label for="{{ id }}" class="{{ v.slots.label }}">{{ label }}</label>{% if description %}<span id="{{ id }}-desc" class="{{ v.slots.description }}">{{ description }}</span>{% endif %}</span>
  <button type="button" role="switch" id="{{ id }}" aria-checked="{{ "true" if checked else "false" }}" data-state="{{ st }}"{% if description %} aria-describedby="{{ id }}-desc"{% endif %} class="{{ v.slots.track }}"{% if disabled %} disabled{% endif %}><span data-state="{{ st }}" class="{{ v.slots.thumb }}"></span></button>
</div>
{%- endmacro %}
