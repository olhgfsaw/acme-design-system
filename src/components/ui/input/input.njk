{#- BaseInput. Props: id, name, type, value, placeholder, size, invalid, required, disabled, describedby, inputmode, autocomplete, numeric (tabular-nums), label (aria-label, only where no visible label exists), variant (outline | search), iconLeading. Use inside FormField; variant search is the global search in TopBar. -#}
{% macro input(id, name=null, type="text", value="", placeholder="", size="md", invalid=false, required=false, disabled=false, describedby=null, inputmode=null, autocomplete=null, numeric=false, label=null, variant="outline", iconLeading=null) %}
{%- set v = variants.input -%}
{%- if iconLeading %}<div class="{{ v.slots.wrapper }}">{{ icon(iconLeading, v.slots.icon) }}{% endif -%}
<input id="{{ id }}" name="{{ name or id }}" type="{{ type }}" data-component="BaseInput" data-variant="{{ variant }}" data-size="{{ size }}" class="{{ v.base }} {{ v.variants.variant[variant] }} {{ v.variants.size[size] }}{% if numeric %} tabular-nums{% endif %}"
  {%- if value %} value="{{ value }}"{% endif %}
  {%- if placeholder %} placeholder="{{ placeholder }}"{% endif %}
  {%- if label %} aria-label="{{ label }}"{% endif %}
  {%- if invalid %} aria-invalid="true"{% endif %}
  {%- if required %} required{% endif %}
  {%- if disabled %} disabled{% endif %}
  {%- if describedby %} aria-describedby="{{ describedby }}"{% endif %}
  {%- if inputmode %} inputmode="{{ inputmode }}"{% endif %}
  {%- if autocomplete %} autocomplete="{{ autocomplete }}"{% endif %}>
{%- if iconLeading %}</div>{% endif -%}
{%- endmacro %}
