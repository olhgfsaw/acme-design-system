{% extends "layouts/matrix.njk" %}
{% from "layouts/_matrix-macros.njk" import section, cell %}
{% from "components/ui/input/input.njk" import input %}
{% set description = "Inputs are always used with a visible label (FormField). Here they carry aria-label for the matrix only. The search variant is the global search in TopBar." %}
{% block matrix %}
{% call section("states") %}
  {% call cell("empty") %}<div class="w-72">{{ input("m-empty", placeholder=sample.companyPlaceholder, label=sample.company) }}</div>{% endcall %}
  {% call cell("filled") %}<div class="w-72">{{ input("m-filled", value=sample.companyValue, label=sample.company) }}</div>{% endcall %}
  {% call cell("invalid") %}<div class="w-72">{{ input("m-invalid", value=sample.phoneShort, invalid=true, label=sample.phone) }}</div>{% endcall %}
  {% call cell("disabled") %}<div class="w-72">{{ input("m-disabled", value=sample.readOnly, disabled=true, label=sample.source) }}</div>{% endcall %}
{% endcall %}
{% call section("size") %}
  {% call cell("sm") %}<div class="w-72">{{ input("m-sm", size="sm", placeholder=sample.search, label=sample.search) }}</div>{% endcall %}
  {% call cell("md") %}<div class="w-72">{{ input("m-md", placeholder=sample.search, label=sample.searchDeals) }}</div>{% endcall %}
{% endcall %}
{% call section("AI-filled") %}
  {% call cell("attention") %}<div class="w-72">{{ input("m-att", value="PO-KC-0412", variant="attention", label="Client PO number") }}</div>{% endcall %}
  {% call cell("missing") %}<div class="w-72">{{ input("m-miss", placeholder="Optional", variant="missing", label="Client PO number") }}</div>{% endcall %}
{% endcall %}
{% call section("search") %}
  {% call cell("search · lg") %}<div class="w-96">{{ input("m-search", type="search", variant="search", size="lg", iconLeading="search", placeholder=sample.searchPlaceholder, label=sample.searchLabel) }}</div>{% endcall %}
  {% call cell("search · filled") %}<div class="w-96">{{ input("m-search-filled", type="search", variant="search", size="lg", iconLeading="search", value=sample.companyValue, label=sample.searchLabel) }}</div>{% endcall %}
{% endcall %}
{% endblock %}
