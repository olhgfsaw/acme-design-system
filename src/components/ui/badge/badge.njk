{#- BaseBadge. Props: label, tone (neutral | info | success | warning | danger | accent), dot, size (sm | md), iconName (replaces the dot). For statuses: {{ statusBadge("dealStatus", deal.status) }}. -#}
{% macro badge(label, tone="neutral", dot=true, size="sm", iconName=null) %}
{%- set v = variants.badge -%}
<span data-component="BaseBadge" data-tone="{{ tone }}" data-size="{{ size }}" class="{{ v.base }} {{ v.variants.tone[tone] }} {{ v.variants.size[size] }}">
  {%- if iconName %}{{ icon(iconName, "size-4" if size == "md" else "size-3") }}{% elif dot %}<span class="size-1.5 rounded-full bg-current" aria-hidden="true"></span>{% endif -%}
  {{ label }}
</span>
{%- endmacro %}

{% macro statusBadge(dict, code) %}
{%- set s = data.statuses[dict][code] -%}
{{ badge(s.label | label, tone=s.tone) }}
{%- endmacro %}
