{% extends "layouts/matrix.njk" %}
{% from "layouts/_matrix-macros.njk" import section, cell %}
{% from "components/ui/icon-button/icon-button.njk" import iconButton %}
{% set description = "Icon-only buttons always carry a label (aria-label)." %}
{% block matrix %}
{% for variant in ["ghost", "secondary"] %}
  {% call section(variant) %}
    {% for size in ["sm", "md"] %}
      {% call cell(size) %}{{ iconButton(sample.close, "x", variant=variant, size=size) }}{% endcall %}
    {% endfor %}
    {% call cell("disabled") %}{{ iconButton(sample.delete, "trash-2", variant=variant, disabled=true) }}{% endcall %}
  {% endcall %}
{% endfor %}
{% endblock %}
