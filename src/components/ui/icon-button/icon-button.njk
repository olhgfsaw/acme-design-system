{#- BaseIconButton. Props: label (required → aria-label; say what is unread when dot is on), icon, variant, size, disabled, dot (unread marker). -#}
{% macro iconButton(label, iconName, variant="ghost", size="md", disabled=false, layout="", dot=false) %}
{%- set v = variants.iconButton -%}
<button type="button" aria-label="{{ label }}" data-component="BaseIconButton" data-variant="{{ variant }}" data-size="{{ size }}" class="{{ (v.base ~ " " ~ v.variants.variant[variant] ~ " " ~ v.variants.size[size] ~ " " ~ layout) | trim }}"{% if disabled %} disabled{% endif %}>
  {{- icon(iconName, "size-4" if size == "sm" else "size-5") -}}
  {%- if dot %}<span class="{{ v.slots.dot }}" aria-hidden="true"></span>{% endif -%}
</button>
{%- endmacro %}
