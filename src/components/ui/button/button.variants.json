      "primary": "bg-primary text-on-primary hover:bg-primary-hover active:bg-primary-active",
      "secondary": "bg-surface-subtle text-fg hover:bg-divider active:bg-divider",
      "ghost": "text-fg-secondary hover:bg-surface-subtle hover:text-fg active:bg-surface-subtle",
      "danger": "bg-danger-solid text-on-danger hover:bg-danger-solid-hover active:bg-danger-solid-hover"
