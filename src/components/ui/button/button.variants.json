    "size": {
      "sm": "h-9 px-4 text-sm pointer-coarse:h-11",
      "md": "h-12 px-6 text-base",
      "lg": "h-14 px-8 text-base"
    }
  },
  "defaultVariants": {
    "variant": "primary",
