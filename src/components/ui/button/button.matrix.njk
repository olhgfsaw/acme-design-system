{% extends "layouts/matrix.njk" %}
{% from "layouts/_matrix-macros.njk" import section, cell %}
{% from "components/ui/button/button.njk" import button %}
{% set description = "Variants × sizes × states. Check hover and focus by pointing and tabbing inside the frame." %}
{% block matrix %}
{% for variant in ["primary", "secondary", "ghost", "danger"] %}
  {% call section(variant) %}
    {% for size in ["sm", "md", "lg"] %}
      {% call cell(size) %}{{ button(sample.create, variant=variant, size=size) }}{% endcall %}
    {% endfor %}
    {% call cell("icon") %}{{ button(sample.export, variant=variant, iconLeading="download") }}{% endcall %}
    {% call cell("loading") %}{{ button(sample.saving, variant=variant, loading=true, disabled=true) }}{% endcall %}
    {% call cell("disabled") %}{{ button(sample.unavailable, variant=variant, disabled=true) }}{% endcall %}
  {% endcall %}
{% endfor %}
{% endblock %}
