{% extends "layouts/matrix.njk" %}
{% from "layouts/_matrix-macros.njk" import section, cell %}
{% from "components/ui/button/button.njk" import button %}
{% set description = "Pill buttons. One primary per view, last in a row. Check hover and focus by pointing and tabbing inside the frame." %}
{% block matrix %}
{% for variant in ["primary", "secondary", "ghost", "danger"] %}
  {% call section(variant) %}
    {% for size in ["sm", "md", "lg"] %}
      {% call cell(size) %}{{ button(sample.create, variant=variant, size=size) }}{% endcall %}
    {% endfor %}
    {% call cell("icon") %}{{ button(sample.export, variant=variant, iconLeading="download") }}{% endcall %}
    {% call cell("loading") %}{{ button(sample.saving, variant=variant, loading=true, disabled=true) }}{% endcall %}
    {% call cell("disabled") %}{{ button(sample.unavailable, variant=variant, disabled=true) }}{% endcall %}
  {% endcall %}
{% endfor %}
{% call section("toggle") %}
  {% call cell("off") %}{{ button("Pin to dashboard", variant="secondary", iconLeading="pin", pressed=false) }}{% endcall %}
  {% call cell("on") %}{{ button("Pin to dashboard", variant="secondary", iconLeading="pin", pressed=true) }}{% endcall %}
{% endcall %}
{% call section("as a link") %}
  {% call cell("secondary · href") %}{{ button(sample.create, variant="secondary", iconLeading="plus", href="#") }}{% endcall %}
  {% call cell("primary · lg · href") %}{{ button(sample.upgradeNow, size="lg", iconTrailing="arrow-right", href="#") }}{% endcall %}
{% endcall %}
{% call section("full width (promo call to action)") %}
  {% call cell("lg · w-full") %}<div class="w-80">{{ button(sample.upgradeNow, size="lg", iconTrailing="arrow-right", layout="w-full") }}</div>{% endcall %}
{% endcall %}
{% endblock %}
