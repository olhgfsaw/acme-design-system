{#- BaseButton. Props: label, variant, size, type, disabled, loading, iconLeading, iconTrailing, layout (layout utilities only), href (renders a link that looks like a button: navigation, not an action). Default slot via {% call %}. -#}
{% macro button(label="", variant="primary", size="md", type="button", disabled=false, loading=false, iconLeading=null, iconTrailing=null, layout="", href=null) %}
{%- set v = variants.button -%}
{%- if href %}<a href="{{ href }}"{% else %}<button type="{{ type }}"{% endif %} data-component="BaseButton" data-variant="{{ variant }}" data-size="{{ size }}" class="{{ (v.base ~ " " ~ v.variants.variant[variant] ~ " " ~ v.variants.size[size] ~ " " ~ layout) | trim }}"{% if disabled %} disabled{% endif %}{% if loading %} aria-busy="true"{% endif %}>
  {%- if loading %}{{ icon("loader-circle", "size-4 motion-safe:animate-spin") }}{% elif iconLeading %}{{ icon(iconLeading, "size-4") }}{% endif -%}
  {%- if caller %}{{ caller() }}{% else %}<span>{{ label }}</span>{% endif -%}
  {%- if iconTrailing %}{{ icon(iconTrailing, "size-4") }}{% endif -%}
{% if href %}</a>{% else %}</button>{% endif %}
{%- endmacro %}
