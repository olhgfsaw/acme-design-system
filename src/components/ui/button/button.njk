{#- BaseButton. Props: label, variant, size, type, disabled, loading, iconLeading, iconTrailing, layout (layout utilities only). Default slot via {% call %}. -#}
{% macro button(label="", variant="primary", size="md", type="button", disabled=false, loading=false, iconLeading=null, iconTrailing=null, layout="") %}
{%- set v = variants.button -%}
<button type="{{ type }}" data-component="BaseButton" data-variant="{{ variant }}" data-size="{{ size }}" class="{{ (v.base ~ " " ~ v.variants.variant[variant] ~ " " ~ v.variants.size[size] ~ " " ~ layout) | trim }}"{% if disabled %} disabled{% endif %}{% if loading %} aria-busy="true"{% endif %}>
  {%- if loading %}{{ icon("loader-circle", "size-4 motion-safe:animate-spin") }}{% elif iconLeading %}{{ icon(iconLeading, "size-4") }}{% endif -%}
  {%- if caller %}{{ caller() }}{% else %}<span>{{ label }}</span>{% endif -%}
  {%- if iconTrailing %}{{ icon(iconTrailing, "size-4") }}{% endif -%}
</button>
{%- endmacro %}
