{#- CalendarGrid. A month as a table: weekday headers, one row per week, each day with its number (a button that selects the day), up to 3 event chips colored by calendar, then "+2 more". Props: id, year, month (1–12), events [{ date (YYYY-MM-DD), time (formatted, optional), title, tone (info | danger | success | warning | neutral) }], today and selected (YYYY-MM-DD), weekStart (0 = Sunday, 1 = Monday; the locale's first day), labelledby (the visible month heading), state (default | loading | error), messages ({ loading, errorTitle, errorText, retry }). Below md the chips become dots; the day button's name still says how many events there are. Cells and day buttons carry Reka Calendar's data-selected / data-outside-view; today has aria-current="date". In Nuxt the more button opens a popover with the day's list. -#}
{% from "components/ui/skeleton/skeleton.njk" import skeleton %}
{% from "components/common/error-state/error-state.njk" import errorState %}
{% macro calendarGrid(id, year, month, events, today, selected=null, weekStart=0, labelledby=null, state="default", messages={}) %}
{%- set v = variants.calendarGrid -%}
{%- if state == "error" %}<div data-component="CalendarGrid" class="rounded-lg border border-divider p-6">{{ errorState(messages.errorTitle, messages.errorText, messages.retry) }}</div>
{%- else -%}
{#- Weekday of the 1st (Sakamoto), days in this and the previous month. -#}
{%- set t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4] -%}
{%- set yy = year - 1 if month < 3 else year -%}
{%- set dow1 = (yy + (yy / 4) | int - (yy / 100) | int + (yy / 400) | int + t[month - 1] + 1) % 7 -%}
{%- set leap = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0 -%}
{%- set dim = [31, 29 if leap else 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31] -%}
{%- set days = dim[month - 1] -%}
{%- set prevDays = dim[(month + 10) % 12] -%}
{%- set offset = (dow1 - weekStart + 7) % 7 -%}
{%- set rows = ((offset + days + 6) / 7) | int -%}
{%- set wd = data.glossary.weekdaysShort | label -%}{%- set wdl = data.glossary.weekdays | label -%}
<table data-component="CalendarGrid" id="{{ id }}" class="{{ v.base }}"{% if labelledby %} aria-labelledby="{{ labelledby }}"{% endif %}{% if state == "loading" %} aria-busy="true"{% endif %}>
  {%- if state == "loading" %}<caption class="sr-only">{{ messages.loading }}</caption>{% endif %}
  <thead><tr>{% for i in range(0, 7) %}{% set k = (i + weekStart) % 7 %}<th scope="col" class="{{ v.slots.head }}"><abbr title="{{ wdl[k] }}" class="{{ v.slots.abbr }}">{{ wd[k] }}</abbr></th>{% endfor %}</tr></thead>
  <tbody>
  {%- for r in range(0, rows) %}<tr>
    {%- for c in range(0, 7) %}
    {%- set n = r * 7 + c - offset + 1 -%}
    {%- if n < 1 %}{% set dm = month - 1 if month > 1 else 12 %}{% set dy = year if month > 1 else year - 1 %}{% set dd = prevDays + n %}{% set out = true %}
    {%- elif n > days %}{% set dm = month + 1 if month < 12 else 1 %}{% set dy = year if month < 12 else year + 1 %}{% set dd = n - days %}{% set out = true %}
    {%- else %}{% set dm = month %}{% set dy = year %}{% set dd = n %}{% set out = false %}{% endif -%}
    {%- set key = dy ~ "-" ~ ("0" ~ dm).slice(-2) ~ "-" ~ ("0" ~ dd).slice(-2) -%}
    {%- set list = [] %}{% if state != "loading" %}{% for e in events %}{% if e.date == key %}{% set _ = list.push(e) %}{% endif %}{% endfor %}{% endif -%}
    {%- set name = wdl[(c + weekStart) % 7] ~ ", " ~ ((key ~ "T12:00:00Z") | date("long")) ~ ((", " ~ (list | length | plural({ one: "# event", other: "# events" }))) if list | length else "") -%}
    <td class="{{ v.slots.cell }}"{% if key == selected %} data-selected{% endif %}{% if out %} data-outside-view{% endif %}>
      <div class="flex min-w-0 flex-col items-start">
      <button type="button" aria-label="{{ name }}" aria-pressed="{{ "true" if key == selected else "false" }}"{% if key == today %} aria-current="date"{% endif %} class="{{ v.slots.day }}"{% if out and key != today %} data-outside-view{% endif %}>{{ dd }}</button>
      {%- if state == "loading" %}{% if (r + c) % 3 == 0 %}<span class="{{ v.slots.skeleton }} w-full">{{ skeleton("line", layout="w-full") }}</span>{% endif %}
      {%- elif list | length %}
      <ul class="{{ v.slots.chips }} w-full">{% for e in list.slice(0, 3) %}<li class="{{ v.slots.chip }} {{ v.variants.tone[e.tone] }}" title="{% if e.time %}{{ e.time }} · {% endif %}{{ e.title }}">{% if e.time %}<span class="{{ v.slots.chipTime }}">{{ e.time }}</span>{% endif %}<span class="{{ v.slots.chipTitle }}">{{ e.title }}</span></li>{% endfor %}
        {%- if list | length > 3 %}<li class="flex"><button type="button" aria-haspopup="dialog" aria-label="{{ (list | length - 3) | plural({ one: "# more event", other: "# more events" }) }} on {{ (key ~ "T12:00:00Z") | date("medium") }}" class="{{ v.slots.more }}">+{{ (list | length) - 3 }} more</button></li>{% endif %}</ul>
      <span class="{{ v.slots.dots }}" aria-hidden="true">{% for e in list.slice(0, 4) %}<span class="{{ v.slots.dotItem }} {{ v.variants.dot[e.tone] }}"></span>{% endfor %}</span>
      {%- endif %}
      </div>
    </td>
    {%- endfor %}
  </tr>{% endfor %}
  </tbody>
</table>
{%- endif %}
{%- endmacro %}
