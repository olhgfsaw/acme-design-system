{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invite",
  "x-entity": "invite",
  "x-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "email",
    "access",
    "sentAt",
    "expiresAt",
    "status"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique identifier"
    },
    "name": {
      "type": "string",
      "maxLength": 200,
      "description": "Invited person"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Where the invite went"
    },
    "role": {
      "type": "string",
      "maxLength": 80,
      "description": "Job title"
    },
    "access": {
      "type": "string",
      "enum": [
        "admin",
        "member"
      ],
      "description": "Access after joining"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Projects they join"
    },
    "sentAt": {
      "type": "string",
      "format": "date",
      "description": "When it was sent"
    },
    "expiresAt": {
      "type": "string",
      "format": "date",
      "description": "When the link stops working"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "expired"
      ],
      "x-dict": "inviteStatus",
      "description": "Pending or expired"
    },
    "invitedByName": {
      "type": "string",
      "maxLength": 200,
      "description": "Admin who sent the invite"
    }
  }
}
