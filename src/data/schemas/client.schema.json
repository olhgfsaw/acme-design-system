{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client",
  "x-entity": "client",
  "x-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "revenueMinor",
    "currency"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique identifier"
    },
    "name": {
      "type": "string",
      "maxLength": 200,
      "description": "Client display name"
    },
    "revenueMinor": {
      "type": "integer",
      "minimum": 0,
      "description": "Revenue from the client this month in minor units of currency"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 code"
    },
    "avatarUrl": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "Photo or logo; absent or null shows initials"
    }
  }
}
