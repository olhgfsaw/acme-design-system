{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeamMember",
  "x-entity": "teamMember",
  "x-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "performancePercent"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique identifier"
    },
    "name": {
      "type": "string",
      "maxLength": 120,
      "description": "Short display name: first name and initial"
    },
    "performancePercent": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "Share of this month's goals met, 0–100; null when not rated yet"
    }
  }
}
