{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeamMember",
  "x-entity": "teamMember",
  "x-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "fullName",
    "workloadPercent"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique identifier"
    },
    "name": {
      "type": "string",
      "maxLength": 120,
      "description": "Short display name: first name and initial"
    },
    "fullName": {
      "type": "string",
      "maxLength": 200,
      "description": "Full name for screen readers and profiles"
    },
    "workloadPercent": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 200,
      "description": "Share of this month's working hours already booked; over 100 means overbooked; null when no hours are set"
    }
  }
}
