{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project",
  "x-entity": "project",
  "x-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "kind",
    "status",
    "health",
    "stage",
    "cover",
    "progressPercent"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique identifier"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "description": "Project name shown in lists"
    },
    "clientName": {
      "type": "string",
      "maxLength": 200,
      "description": "Display name of the client; absent for internal projects"
    },
    "kind": {
      "type": "string",
      "enum": [
        "website",
        "app",
        "marketing",
        "landing",
        "brand"
      ],
      "description": "Kind of work; picks the icon in lists"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed",
        "in_review",
        "on_hold"
      ],
      "x-dict": "projectStatus",
      "description": "Code; labels and tones in statuses.json"
    },
    "health": {
      "type": "string",
      "enum": [
        "normal",
        "on_track",
        "at_risk"
      ],
      "x-dict": "projectHealth",
      "description": "Schedule health; labels and tones in statuses.json"
    },
    "progressPercent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Share of the work done, 0–100"
    },
    "stage": {
      "type": "string",
      "enum": [
        "discovery",
        "design",
        "development",
        "review",
        "launch"
      ],
      "x-dict": "projectStage",
      "description": "Current stage, in this order; labels in statuses.json"
    },
    "dueDate": {
      "type": "string",
      "format": "date",
      "description": "Planned launch date; absent while not planned"
    },
    "cover": {
      "type": "string",
      "enum": [
        "ink",
        "dots",
        "grid",
        "rings",
        "stripes",
        "plain"
      ],
      "description": "Cover pattern chosen for the project"
    },
    "pinned": {
      "type": "boolean",
      "description": "Pinned to the current user's dashboard; absent means false"
    },
    "openedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the current user last opened it (UTC); absent if never"
    },
    "budgetMinor": {
      "type": "integer",
      "minimum": 0,
      "description": "Agreed budget, minor units"
    },
    "paidMinor": {
      "type": "integer",
      "minimum": 0,
      "description": "Paid so far, minor units"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 code"
    },
    "team": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "People on the project, lead first"
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "description": "When work started"
    },
    "billing": {
      "type": "string",
      "enum": [
        "fixed",
        "hourly",
        "retainer"
      ],
      "description": "How the client pays"
    },
    "stageDates": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      },
      "minItems": 5,
      "maxItems": 5,
      "description": "Target date of each stage, in stage order"
    }
  }
}
