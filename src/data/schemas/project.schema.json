{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project",
  "x-entity": "project",
  "x-status": "draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "kind",
    "status",
    "health",
    "progressPercent"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique identifier"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "description": "Project name shown in lists"
    },
    "clientName": {
      "type": "string",
      "maxLength": 200,
      "description": "Display name of the client; absent for internal projects"
    },
    "kind": {
      "type": "string",
      "enum": [
        "website",
        "app",
        "marketing",
        "landing"
      ],
      "description": "Kind of work; picks the icon in lists"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed",
        "in_review",
        "on_hold"
      ],
      "x-dict": "projectStatus",
      "description": "Code; labels and tones in statuses.json"
    },
    "health": {
      "type": "string",
      "enum": [
        "normal",
        "on_track",
        "at_risk"
      ],
      "x-dict": "projectHealth",
      "description": "Schedule health; labels and tones in statuses.json"
    },
    "progressPercent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Share of the work done, 0–100"
    }
  }
}
