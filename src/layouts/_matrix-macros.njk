{#- Helpers for matrix pages. -#}
{% macro section(title) %}
<section class="flex flex-col gap-3">
  <h2 class="text-sm font-semibold text-fg-secondary">{{ title }}</h2>
  <div class="flex flex-wrap items-start gap-6 rounded-lg border border-divider bg-surface p-6">
    {{ caller() }}
  </div>
</section>
{% endmacro %}

{% macro cell(label) %}
<div class="flex flex-col items-start gap-2">
  {{ caller() }}
  <span class="font-mono text-xs text-fg-muted">{{ label }}</span>
</div>
{% endmacro %}
