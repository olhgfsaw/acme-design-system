{
  "name": "design-system",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "render": "node build/render-cli.js",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "node build/render-cli.js && eslint frames",
    "check": "node scripts/check.js",
    "test:a11y": "playwright test tests/a11y.spec.js",
    "test:visual": "playwright test tests/visual.spec.js",
    "verify": "npm run check && npm run lint && npm run build && npm run test:a11y",
    "approve:visual": "playwright test tests/visual.spec.js --update-snapshots",
    "design-system": "node scripts/design-system-export.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@html-eslint/eslint-plugin": "^0.67.0",
    "@html-eslint/parser": "^0.67.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "lucide-static": "^1.60.0",
    "nunjucks": "^3.2.4",
    "tailwindcss": "^4.3.0",
    "vite": "^8.3.0"
  }
}
